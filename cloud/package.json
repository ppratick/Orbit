{
  "name": "orbit-cloud",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "db:migrate:local": "wrangler d1 migrations apply orbit --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote -c wrangler.local.jsonc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "node test/e2e/run.mjs",
    "deploy": "wrangler deploy -c wrangler.local.jsonc"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261110.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "wrangler": "^4.160.1"
  }
}
