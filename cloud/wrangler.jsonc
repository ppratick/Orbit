{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "orbit",
  "account_id": "9825d44dc1fece5fca3cc36e35403660",
  "workers_dev": true,
  "preview_urls": false,
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "services": [{ "binding": "SELF", "service": "orbit" }],
  "observability": { "enabled": true },
  // Source polling runs in independent invocations every ten minutes.
  // Due schedules and adaptive goal checks are dispatched every minute.
  "triggers": { "crons": ["*/10 * * * *", "* * * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "orbit",
      "database_id": "8bc78c09-f493-41c1-9446-db058120c68b",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    // Model IDs per OpenAI's model docs; check against your account with GET /v1/model?verify=1.
    "OPENAI_MODEL_BASIC": "gpt-6-luna",
    "OPENAI_MODEL_ADVANCED": "gpt-6.1-sol",
    "OPENAI_BASE_URL": "https://api.openai.com/v1",
    "ORBIT_TIMEZONE": "America/New_York",
    "ORBIT_CALENDAR_NAME": "Orbit"
  }
  // Secrets (set with `wrangler secret put NAME`, or .dev.vars locally):
  //   ADMIN_TOKEN, ENCRYPTION_KEY,
  //   GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET, PUBLIC_BASE_URL,
  //   APNS_KEY_P8, APNS_KEY_ID, APNS_TEAM_ID, APNS_TOPIC   (optional)
  //   CF_ACCOUNT_ID, CF_BROWSER_TOKEN                       (optional, Browser Run REST)
}
